# Copy to .bo_env and fill in. `.bo_env` is gitignored.
# Source it before running the scripts:  set -a; . ./.bo_env; set +a

# ── SAP BusinessObjects (BI RESTful Web Service) ─────────────────────────────
# RWS runs ON the on-prem BO server. You must run these scripts somewhere that
# can reach it (the customer's network / VPN). Default RWS port is 6405.
BO_BASE_URL=https://your-bo-server:6405/biprws
BO_USER=Administrator
BO_PASSWORD=changeme
BO_AUTH=secEnterprise          # secEnterprise | secLDAP | secWinAD | secSAPR3

# ── Sigma ────────────────────────────────────────────────────────────────────
SIGMA_BASE_URL=https://aws-api.sigmacomputing.com
# Either a ready bearer token…
SIGMA_API_TOKEN=
# …or client credentials (exchanged automatically):
SIGMA_CLIENT_ID=
SIGMA_CLIENT_SECRET=

SIGMA_FOLDER_ID=               # target folder for created data models / workbooks
SIGMA_CONNECTION_ID=           # warehouse connection the universe's tables live on
SIGMA_DATABASE=                # optional path override (else inferred per table)
SIGMA_SCHEMA=                  # optional path override

# ── Crystal Reports extraction ───────────────────────────────────────────────
# Loose .rpt on Windows: directory containing matching x64 CrystalDecisions DLLs.
CRYSTAL_SDK_DIR=
# CMS/RAS extractor (BI Platform Java SDK jars + CMS host).
BO_SDK_LIB=
BO_CMS=
# Linux smoke extraction only (rpt-rs executable).
RPT_RS_BIN=

# ── Snowflake sample seed (key-pair auth) ────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Complete unencrypted PEM text, including BEGIN/END PRIVATE KEY lines.
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=

# Isolated destination created by scripts/seed-crystal-snowflake.py.
CRYSTAL_SNOWFLAKE_DATABASE=CRYSTAL_MIGRATION_DEMO
CRYSTAL_SNOWFLAKE_SCHEMA=PUBLIC
# Optional read-only consumer role used by the Sigma connection.
CRYSTAL_SIGMA_ROLE=SIGMA_ROLE

# Persistent report creation has no API cleanup. The E2E refuses to create
# unless this is explicitly true and SIGMA_FOLDER_ID is approved.
CRYSTAL_E2E_CREATE=false

# PettyCash source/PDF visual-oracle gate. Creation can be resumed in place
# after the first run by setting the returned report ID.
PETTYCASH_E2E_CREATE=false
PETTYCASH_E2E_REPORT_ID=
