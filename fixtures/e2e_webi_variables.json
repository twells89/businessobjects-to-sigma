{
  "document": {
    "name": "Retail E2E Tie-Out",
    "variables": [
      { "name": "Margin Pct", "qualification": "measure", "formula": "=Sum([Net Revenue]) / Sum([Gross Revenue])" },
      { "name": "Running Revenue", "qualification": "measure", "formula": "=RunningSum([Net Revenue])" },
      { "name": "Regional Net Revenue", "qualification": "measure", "formula": "=Sum([Net Revenue]) In ([Customer Region])" },
      { "name": "All Time Net Revenue", "qualification": "measure", "formula": "=NoFilter(Sum([Net Revenue]))" },
      { "name": "Region Bucket", "qualification": "dimension", "formula": "=If([Customer Region] = \"West\" ; \"West\" ; \"Other\")" }
    ],
    "reports": [
      {
        "name": "Overview",
        "blocks": [
          { "kind": "Cell", "title": "Net Revenue Total", "measures": ["Net Revenue"] },
          { "kind": "Cell", "title": "Gross Revenue Total", "measures": ["Gross Revenue"] },
          { "kind": "Cell", "title": "Margin Pct", "measures": ["Margin Pct"] },
          { "kind": "Cell", "title": "All Time Net Revenue", "measures": ["All Time Net Revenue"] },
          { "kind": "VTable", "title": "Region Summary",
            "dimensions": ["Customer Region"],
            "measures": ["Net Revenue", "Gross Revenue", "Regional Net Revenue", "Running Revenue"],
            "breaks": ["Customer Region"],
            "sort": [{ "name": "Net Revenue", "direction": "descending" }],
            "alerters": [{ "column": "Net Revenue", "operator": ">", "value": 30000, "style": { "backgroundColor": "#c8e6c9", "color": "#1b5e20" } }] },
          { "kind": "VTable", "title": "Region Raw Check",
            "dimensions": ["Customer Region"],
            "measures": ["Net Revenue"],
            "breaks": ["Customer Region"] },
          { "kind": "VTable", "title": "Region Bucket Check",
            "dimensions": ["Customer Region", "Region Bucket"],
            "measures": ["Net Revenue"] }
        ]
      }
    ],
    "filters": []
  }
}
